# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=auction_bidding_system

# Secret used to sign login cookies. Any long random text.
JWT_SECRET=change_me_to_a_long_random_text

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=auction_bidding_system
